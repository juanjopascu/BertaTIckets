# ==============================================================================
# DACAS Enterprise CRM & E-Commerce - Environment Configuration
# ==============================================================================

# Server Configuration
PORT=3001
NODE_ENV=development

# Security / Authentication
# Must be a long, cryptographically secure random string in production
JWT_SECRET=super_secret_jwt_key_change_in_production_at_least_32_chars

# Database (PostgreSQL)
PGHOST=localhost
PGPORT=5432
PGDATABASE=ecommerce_db
PGUSER=postgres
PGPASSWORD=postgres

# Stripe Payments
STRIPE_SECRET_KEY=sk_test_mock

# AI & Smart Copilot Integration (Google Gemini)
GEMINI_API_KEY=

# ERP Database Storage Override (Optional)
# ERP_DB_FILE=./erp_database.json

# Webhook Security (set true only for local sandbox testing)
ALLOW_PRIVATE_WEBHOOKS=false
